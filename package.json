{
  "name": "pi-subagents",
  "version": "0.1.0",
  "description": "Spawn named child pi agents with a parent overview UI, per-child logs, and intercom for talk between agents.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "pi-coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aj47/pi-subagents.git"
  },
  "files": [
    "extensions/**/*.ts",
    "skills/**/*",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
