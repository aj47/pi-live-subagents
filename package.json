{
  "name": "@aj47/pi-live-subagents",
  "version": "0.1.0",
  "description": "Live named child pi sessions with a parent overview UI, per-child logs, and intercom. Not npm:pi-subagents.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "live-subagents",
    "pi-coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aj47/pi-live-subagents.git"
  },
  "files": [
    "extensions/index.ts",
    "extensions/manager.ts",
    "extensions/ui.ts",
    "skills/**/*",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
